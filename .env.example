# ---- Database (Neon project: suds / autumn-flower-67361637) ----
# Pooled connection for the app runtime.
DATABASE_URL=""
# Unpooled connection for migrations: the same host with the "-pooler" suffix
# removed. Neon's pooler cannot hold prisma migrate's advisory locks.
DIRECT_URL=""

# ---- Seeding ----
# Password `db:seed` gives the owner account (owner@suds.local). Leave empty for
# local development and the seed falls back to a printed default — never leave
# the default on a database anyone else can reach.
SEED_OWNER_PASSWORD=""

# Optional server-only video integrations. Empty keys keep the flows disabled.
SUBMAGIC_API_KEY=""
SHOTSTACK_API_KEY=""
# stage makes watermarked test renders; v1 uses the production rendering account.
SHOTSTACK_ENV="stage"

# Public origin used in verification emails, booking links, and marketing.
PUBLIC_APP_URL="http://localhost:3000"
# Optional: restrict business-owner signup for an invite-only pilot. Customers don't need it.
SIGNUP_CODE=""
# Resend-compatible transactional email HTTP endpoint and server-only credentials.
EMAIL_PROVIDER_URL="https://api.resend.com/emails"
EMAIL_PROVIDER_TOKEN=""
EMAIL_FROM=""
# >=32 random characters; protects the background-worker endpoint.
CRON_SECRET=""
# Hosted assistant. Select a supported Responses model explicitly.
OPENAI_API_KEY=""
MARKETING_MODEL=""
# Private R2/S3-compatible object storage. local is development only.
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional exact hostnames permitted for rendered outputs beyond built-in provider hosts.
AI_MEDIA_ALLOWED_HOSTS=""
# Explicit destructive demo seed permission, only for disposable development DBs.
ALLOW_DESTRUCTIVE_DEMO_SEED="no"
