{
  "name": "suds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "demo:prepare": "node scripts/prepare-demo.mjs",
    "demo": "node scripts/demo.mjs",
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "smoke:launch": "node --env-file-if-exists=.env --import tsx scripts/smoke-launch.ts",
    "smoke:auth": "node --env-file-if-exists=.env --import tsx scripts/smoke-auth.ts",
    "preflight": "node --import tsx scripts/preflight.ts",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/worker.ts",
    "worker:loop": "node --env-file-if-exists=.env --import tsx scripts/worker-loop.ts",
    "backup": "node scripts/backup.mjs",
    "media:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate-media.ts"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "next": "^16.0.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.9.1": true
  }
}
